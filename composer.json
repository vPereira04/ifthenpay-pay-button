{
    "name": "ifthenpay/ifthenpay-pay-button",
    "description": "ifthenpay pay buttons, pay links and a link builder for plugins ifthenpay has no integration with.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Ifthenpay\\PayButton\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test:unit:pretty": "../vendor/bin/phpunit -c phpunit.xml.dist --testdox",
        "test:int:pretty": "../vendor/bin/phpunit -c phpunit.integration.xml.dist --testdox"
    }
}
